<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.poli.sw2.Vista.DronVista"
            styleClass="root-pane">

    <top>
        <Label text="Gestión de Drones" styleClass="titulo">
            <BorderPane.margin>
                <Insets top="15" left="15" bottom="5" right="15"/>
            </BorderPane.margin>
        </Label>
    </top>

    <left>
        <!-- El panel de formulario y patrones se desplaza dentro de su propia
             zona, para que crecer en opciones no empuje el área de evidencia
             fuera de la ventana. -->
        <ScrollPane fitToWidth="true" prefWidth="330" hbarPolicy="NEVER"
                    styleClass="panel-scroll">

            <VBox spacing="10" styleClass="panel-formulario">
                <padding>
                    <Insets top="10" left="15" bottom="10" right="15"/>
                </padding>

                <GridPane hgap="8" vgap="8">

                    <Label text="Tipo:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="cmbTipo" prefWidth="160"
                              GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="ID:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtId" editable="false" promptText="Automático"
                               GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Serial:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtSerial" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Modelo:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtModelo" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Fabricante:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtFabricante" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <Label text="Peso (kg):" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtPeso" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                    <Label fx:id="lblCapacidadTanque" text="Tanque (L):"
                           GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtCapacidadTanque"
                               GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                    <Label fx:id="lblDeteccionTermica" text="Térmica:"
                           GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                    <CheckBox fx:id="chkDeteccionTermica"
                              GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                </GridPane>

                <HBox spacing="8">
                    <Button text="Agregar" onAction="#agregarDron"/>
                    <Button text="Actualizar" onAction="#actualizarDronSeleccionado"/>
                    <Button text="Eliminar" onAction="#eliminarDron"/>
                    <Button text="Limpiar" onAction="#limpiarFormulario"/>
                </HBox>

                <Separator/>

                <!-- Patrón Prototype: el usuario parte de una configuración base
                     registrada en vez de rellenar el formulario desde cero. -->
                <Label text="Configuración base:"/>
                <HBox spacing="8">
                    <ComboBox fx:id="cmbPlantilla" prefWidth="160"/>
                    <Button text="Usar" onAction="#usarPlantilla"/>
                </HBox>

                <Separator/>

                <!-- Demostración de los patrones de creación. La salida de ambos
                     botones va al área de evidencia, nunca a la consola. -->
                <Label text="Demostración de patrones:"/>
                <HBox spacing="8">
                    <Button fx:id="btnClonar" text="Clonar" onAction="#clonarDronSeleccionado"/>
                    <Button text="Builder" onAction="#construirConBuilder"/>
                    <Button text="Adapter" onAction="#exportarMisionAJson"/>   
                </HBox>

                <Separator/>

                <!-- Patrón Bridge: el dron seleccionado cambia de modo de control
                     y ejecuta una misión con él, sin recrearse. -->
                <Label text="Control del dron (Bridge):"/>
                <HBox spacing="8">
                    <ComboBox fx:id="cmbModoControl" prefWidth="120"/>
                    <TextField fx:id="txtDestino" promptText="Destino" HBox.hgrow="ALWAYS"/>
                </HBox>
                <HBox spacing="8">
                    <Button text="Ejecutar misión" onAction="#ejecutarMision"/>
                </HBox>

                <Separator/>

                <!-- Patrón Decorator: se añade una batería adicional al dron
                     seleccionado sin modificar su clase. -->
                <Label text="Accesorios (Decorator):"/>
                <HBox spacing="8">
                    <TextField fx:id="txtCapacidadBateria" promptText="mAh (opcional)"/>
                    <Button text="Agregar batería" onAction="#agregarBateria"/>
                </HBox>

                <Separator/>

                <!-- Patrón Composite: jerarquía de sensores con grupos y sensores
                     individuales tratados de la misma forma. No necesita ningún
                     dron seleccionado: la jerarquía es independiente del listado. -->
                <Label text="Sensores (Composite):"/>
                <HBox spacing="8">
                    <Button text="Ver jerarquía" onAction="#mostrarSensores"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </left>

    <center>
        <TableView fx:id="tablaDrones">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                <TableColumn fx:id="colTipo" text="Tipo" prefWidth="100"/>
                <TableColumn fx:id="colSerial" text="Serial" prefWidth="110"/>
                <TableColumn fx:id="colModelo" text="Modelo" prefWidth="110"/>
                <TableColumn fx:id="colFabricante" text="Fabricante" prefWidth="120"/>
                <TableColumn fx:id="colPeso" text="Peso (kg)" prefWidth="80"/>
            </columns>
            <BorderPane.margin>
                <Insets top="10" left="10" bottom="10" right="15"/>
            </BorderPane.margin>
        </TableView>
    </center>

    <bottom>
        <!-- Área de evidencia: aquí escriben todos los botones de demostración
             de patrones. Es de solo lectura y con scroll; nada se imprime por
             consola. -->
        <VBox spacing="6" styleClass="panel-evidencia">
            <padding>
                <Insets top="0" left="10" bottom="10" right="15"/>
            </padding>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Evidencia de los patrones" styleClass="subtitulo"/>
                <Button text="Limpiar evidencia" onAction="#limpiarEvidencia"/>
            </HBox>

            <TextArea fx:id="txtEvidencia"
                      editable="false"
                      wrapText="false"
                      prefRowCount="10"
                      prefHeight="200"
                      promptText="Pulsa Clonar, Builder o Adapter para ver aquí la evidencia."
                      styleClass="area-evidencia"/>
        </VBox>
    </bottom>

</BorderPane>